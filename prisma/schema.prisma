generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============== MULTI-TENANT ==============

model Pharmacy {
  id          String   @id @default(cuid())
  name        String
  address     String?
  city        String?
  country     String   @default("Senegal")
  phone       String?
  email       String?
  logo        String?
  taxId       String?
  currency    String   @default("XOF")
  timezone    String   @default("Africa/Dakar")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscription Subscription?
  users        User[]
  medications  Medication[]
  categories   Category[]
  stockMovements StockMovement[]
  sales        Sale[]
  suppliers    Supplier[]
  purchaseOrders PurchaseOrder[]
  expenses     Expense[]
  attendances  Attendance[]
  auditLogs    AuditLog[]
  notifications Notification[]
  inventories  Inventory[]
  payrolls     Payroll[]
  settings     PharmacySettings?
  customers    Customer[]
  creditPayments CreditPayment[]

  @@map("pharmacies")
}

model PharmacySettings {
  id              String   @id @default(cuid())
  pharmacyId      String   @unique
  pharmacy        Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  taxRate         Float    @default(0)
  lowStockThreshold Int    @default(10)
  expiryAlertDays Int      @default(30)
  receiptHeader   String?
  receiptFooter   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pharmacy_settings")
}

// ============== SUBSCRIPTIONS ==============

enum SubscriptionPlan {
  TRIAL
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

model Subscription {
  id          String             @id @default(cuid())
  pharmacyId  String             @unique
  pharmacy    Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan   @default(TRIAL)
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime           @default(now())
  endDate     DateTime?
  amount         Float              @default(0)
  autoPayEnabled Boolean            @default(false)
  payments       Payment[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("subscriptions")
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Float
  method         String       @default("mobile_money")
  provider       String?      // wave, orange_money, etc.
  reference      String?
  status         String       @default("pending") // pending, completed, failed
  period         String       @default("monthly") // monthly, annual
  sessionToken   String?      @unique // token Wave QR session
  expiresAt      DateTime?    // expiry du QR code
  paidAt         DateTime?
  notes          String?
  recordedBy     String?      // SuperAdmin email who recorded manual payment
  type           String       @default("pharmacy_initiated") // pharmacy_initiated, manual, auto
  createdAt      DateTime     @default(now())

  @@map("payments")
}

// ============== USERS & AUTH ==============

enum Role {
  SUPER_ADMIN
  ADMIN
  PHARMACIST
  CASHIER
  ACCOUNTANT
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  firstName   String
  lastName    String
  phone       String?
  role        Role      @default(CASHIER)
  pharmacyId  String?
  pharmacy    Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  isActive    Boolean   @default(true)
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sales       Sale[]
  attendances Attendance[]
  auditLogs   AuditLog[]
  permissions UserPermission[]

  @@map("users")
}

// ============== RBAC PERMISSIONS ==============

model UserPermission {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuKey    String  // e.g. "dashboard", "medications", "stock", "sales", etc.
  canAccess  Boolean @default(true)

  @@unique([userId, menuKey])
  @@map("user_permissions")
}

// ============== SYSTEM LOGS (SuperAdmin) ==============

model SystemLog {
  id          String   @id @default(cuid())
  level       String   @default("info")  // info, warning, error, critical
  action      String   // LOGIN, IMPERSONATE, SUBSCRIPTION_CHANGE, PHARMACY_CREATE, etc.
  userId      String?
  userEmail   String?
  targetId    String?  // target entity ID (pharmacy, user, etc.)
  targetType  String?  // pharmacy, user, subscription
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([level])
  @@index([action])
  @@index([createdAt])
  @@map("system_logs")
}

// ============== SUPPORT TICKETS ==============

model SupportTicket {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String
  status      String   @default("open") // open, in_progress, resolved, closed
  priority    String   @default("normal") // low, normal, high, urgent
  response    String?
  respondedAt DateTime?
  respondedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("support_tickets")
}

// ============== SAAS CONFIG (SuperAdmin) ==============

model SaasConfig {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  description     String?
  updatedAt       DateTime @updatedAt

  @@map("saas_config")
}

// ============== MEDICATIONS ==============

model Category {
  id          String       @id @default(cuid())
  name        String
  description String?
  pharmacyId  String
  pharmacy    Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medications Medication[]
  createdAt   DateTime     @default(now())

  @@unique([name, pharmacyId])
  @@map("categories")
}

model Medication {
  id           String          @id @default(cuid())
  name         String
  genericName  String?
  barcode      String?
  description  String?
  dosage       String?
  form         String?         // tablet, syrup, injection, etc.
  categoryId   String?
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  pharmacyId   String
  pharmacy     Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  purchasePrice Float          @default(0)
  sellingPrice Float           @default(0)
  quantity     Int             @default(0)  // total stock (warehouse + shelf)
  shelfQuantity Int            @default(0)  // portion on shelves, sellable
  minStock     Int             @default(10)
  expiryDate   DateTime?
  location     String?         // shelf location
  requiresPrescription Boolean @default(false)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  stockMovements StockMovement[]
  saleItems      SaleItem[]
  inventoryItems InventoryItem[]

  @@map("medications")
}

// ============== STOCK ==============

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
  EXPIRED
  TRANSFER
}

model StockMovement {
  id           String       @id @default(cuid())
  medicationId String
  medication   Medication   @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  pharmacyId   String
  pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  type         MovementType
  quantity     Int
  location     String?      // "warehouse" | "shelf" — where the movement applies (destination for TRANSFER)
  reason       String?
  reference    String?      // PO number, sale ID, etc.
  unitPrice    Float?
  createdAt    DateTime     @default(now())

  @@map("stock_movements")
}

model Inventory {
  id          String          @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name        String
  status      String          @default("draft") // draft, in_progress, completed
  startedAt   DateTime?
  completedAt DateTime?
  items       InventoryItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("inventories")
}

model InventoryItem {
  id            String    @id @default(cuid())
  inventoryId   String
  inventory     Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  expectedQty   Int
  actualQty     Int?
  difference    Int?
  createdAt     DateTime  @default(now())

  @@map("inventory_items")
}

// ============== SALES ==============

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  INSURANCE
  CREDIT
}

model Sale {
  id            String        @id @default(cuid())
  pharmacyId    String
  pharmacy      Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  subtotal      Float
  tax           Float         @default(0)
  discount      Float         @default(0)
  total         Float
  paymentMethod PaymentMethod @default(CASH)
  customerName  String?
  customerPhone String?
  amountPaid    Float?        // espèces reçues (CASH uniquement) — null si non renseigné
  change        Float?        // monnaie rendue = amountPaid - total (CASH uniquement)
  isPrescription Boolean      @default(false)
  status        String        @default("completed") // completed, refunded, cancelled
  createdAt     DateTime      @default(now())

  @@index([pharmacyId, customerId])
  @@map("sales")
}

// ============== CARNET (CRÉDIT CLIENT) ==============

model Customer {
  id          String          @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String?
  address     String?
  notes       String?
  creditLimit Float           @default(0) // 0 = pas de limite
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  sales       Sale[]
  payments    CreditPayment[]

  @@unique([pharmacyId, phone])
  @@index([pharmacyId, isActive])
  @@map("customers")
}

model CreditPayment {
  id          String   @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Float
  method      String   @default("CASH") // CASH, MOBILE_MONEY, CARD
  receivedBy  String?  // userId du vendeur qui a encaissé
  notes       String?
  createdAt   DateTime @default(now())

  @@index([pharmacyId, customerId])
  @@map("credit_payments")
}

model SaleItem {
  id           String     @id @default(cuid())
  saleId       String
  sale         Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id])
  quantity     Int
  unitPrice    Float
  total        Float
  createdAt    DateTime   @default(now())

  @@map("sale_items")
}

// ============== SUPPLIERS ==============

model Supplier {
  id          String          @id @default(cuid())
  name        String
  contact     String?
  phone       String?
  email       String?
  address     String?
  pharmacyId  String
  pharmacy    Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  orders      PurchaseOrder[]
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
  total       Float               @default(0)
  status      String              @default("pending") // pending, ordered, received, cancelled
  orderedAt   DateTime?
  receivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicationName  String
  quantity        Int
  unitPrice       Float
  total           Float
  receivedQty     Int?
  createdAt       DateTime      @default(now())

  @@map("purchase_order_items")
}

// ============== EXPENSES & ACCOUNTING ==============

model Expense {
  id          String   @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  category    String   // rent, utilities, salaries, supplies, etc.
  description String?
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("expenses")
}

model Payroll {
  id               String   @id @default(cuid())
  pharmacyId       String
  pharmacy         Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  employeeName     String
  employeeRole     String?     // poste occupé
  month            Int
  year             Int

  // Gains
  baseSalary       Float       // Salaire de base
  seniority        Float    @default(0) // Prime d'ancienneté
  transportAllowance Float  @default(0) // Indemnité de transport
  housingAllowance Float    @default(0) // Indemnité de logement
  bonuses          Float    @default(0) // Primes diverses
  overtime         Float    @default(0) // Heures supplémentaires
  grossSalary      Float       // Salaire brut (calculé)

  // Retenues salariales (part employé)
  ipresGeneral     Float    @default(0) // IPRES régime général 5.6%
  ipresCadre       Float    @default(0) // IPRES régime cadre 2.4% (si cadre)
  cssAccident      Float    @default(0) // CSS cotisation AT (pas d'employé, mais réservé)
  cssMaladie       Float    @default(0) // CSS maladie
  incomeTax        Float    @default(0) // IR (Impôt sur le Revenu) - barème progressif
  trimf            Float    @default(0) // TRIMF (Taxe Représentative de l'Impôt du Minimum Fiscal)
  cfce             Float    @default(0) // CFCE (Contribution Forfaitaire à la Charge de l'Employeur)
  otherDeductions  Float    @default(0) // Autres retenues

  // Charges patronales (pour info bulletin)
  employerIpres    Float    @default(0) // IPRES patronal 8.4%
  employerCss      Float    @default(0) // CSS patronal (AT, PF, maladie)
  employerCfce     Float    @default(0) // CFCE patronale

  // Totaux
  totalGross       Float       // Total brut
  totalDeductions  Float       // Total retenues salariales
  netSalary        Float       // Net à payer

  // Workflow
  status           String   @default("draft")   // draft, validated, paid
  validatedBy      String?  // ID du responsable qui a validé
  validatedAt      DateTime?
  paidAt           DateTime?
  notes            String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([pharmacyId, employeeName, month, year])
  @@map("payrolls")
}

// ============== PERSONNEL ==============

model Attendance {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyId  String
  pharmacy    Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  date        DateTime  @default(now())
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("present") // present, absent, late, leave
  notes       String?
  createdAt   DateTime  @default(now())

  @@map("attendances")
}

// ============== AUDIT & ANOMALIES ==============

model AuditLog {
  id          String   @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // CREATE, UPDATE, DELETE, LOGIN, SALE, etc.
  entity      String   // medication, sale, user, etc.
  entityId    String?
  details     String?  // JSON string with change details
  isSuspicious Boolean @default(false)
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([pharmacyId, createdAt])
  @@index([isSuspicious])
  @@map("audit_logs")
}

// ============== NOTIFICATIONS ==============

model Notification {
  id          String   @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   // stock_low, expiry, fraud, payment, system
  severity    String   @default("info") // info, warning, critical
  isRead      Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())

  @@index([pharmacyId, isRead])
  @@map("notifications")
}
