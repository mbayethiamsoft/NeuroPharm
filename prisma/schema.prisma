generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============== MULTI-TENANT ==============

model Pharmacy {
  id          String   @id @default(cuid())
  name        String
  address     String?
  city        String?
  country     String   @default("Senegal")
  phone       String?
  email       String?
  logo        String?
  taxId       String?
  currency    String   @default("XOF")
  timezone    String   @default("Africa/Dakar")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscription Subscription?
  users        User[]
  medications  Medication[]
  categories   Category[]
  stockMovements StockMovement[]
  sales        Sale[]
  suppliers    Supplier[]
  purchaseOrders PurchaseOrder[]
  expenses     Expense[]
  attendances  Attendance[]
  auditLogs    AuditLog[]
  notifications Notification[]
  inventories  Inventory[]
  payrolls     Payroll[]
  settings     PharmacySettings?
  customers    Customer[]
  creditPayments CreditPayment[]
  insurances   Insurance[]
  insuranceBeneficiaries InsuranceBeneficiary[]
  proformas    Proforma[]
  creditNotes  CreditNote[]
  creditNoteUsages CreditNoteUsage[]
  pendingSales PendingSale[]

  @@map("pharmacies")
}

model PharmacySettings {
  id              String   @id @default(cuid())
  pharmacyId      String   @unique
  pharmacy        Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  taxRate         Float    @default(0)
  lowStockThreshold Int    @default(10)
  expiryAlertDays Int      @default(30)
  receiptHeader   String?
  receiptFooter   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pharmacy_settings")
}

// ============== SUBSCRIPTIONS ==============

enum SubscriptionPlan {
  TRIAL
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

model Subscription {
  id          String             @id @default(cuid())
  pharmacyId  String             @unique
  pharmacy    Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan   @default(TRIAL)
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime           @default(now())
  endDate     DateTime?
  amount         Float              @default(0)
  autoPayEnabled Boolean            @default(false)
  payments       Payment[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("subscriptions")
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Float
  method         String       @default("mobile_money")
  provider       String?      // wave, orange_money, etc.
  reference      String?
  status         String       @default("pending") // pending, completed, failed
  period         String       @default("monthly") // monthly, annual
  sessionToken   String?      @unique // token Wave QR session
  expiresAt      DateTime?    // expiry du QR code
  paidAt         DateTime?
  notes          String?
  recordedBy     String?      // SuperAdmin email who recorded manual payment
  type           String       @default("pharmacy_initiated") // pharmacy_initiated, manual, auto
  createdAt      DateTime     @default(now())

  @@map("payments")
}

// ============== USERS & AUTH ==============

enum Role {
  SUPER_ADMIN
  ADMIN
  PHARMACIST
  CASHIER
  ACCOUNTANT
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  firstName   String
  lastName    String
  phone       String?
  role        Role      @default(CASHIER)
  pharmacyId  String?
  pharmacy    Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  isActive    Boolean   @default(true)
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sales       Sale[]
  attendances Attendance[]
  auditLogs   AuditLog[]
  permissions UserPermission[]

  @@map("users")
}

// ============== RBAC PERMISSIONS ==============

model UserPermission {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuKey    String  // e.g. "dashboard", "medications", "stock", "sales", etc.
  canAccess  Boolean @default(true)

  @@unique([userId, menuKey])
  @@map("user_permissions")
}

// ============== SYSTEM LOGS (SuperAdmin) ==============

model SystemLog {
  id          String   @id @default(cuid())
  level       String   @default("info")  // info, warning, error, critical
  action      String   // LOGIN, IMPERSONATE, SUBSCRIPTION_CHANGE, PHARMACY_CREATE, etc.
  userId      String?
  userEmail   String?
  targetId    String?  // target entity ID (pharmacy, user, etc.)
  targetType  String?  // pharmacy, user, subscription
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([level])
  @@index([action])
  @@index([createdAt])
  @@map("system_logs")
}

// ============== SUPPORT TICKETS ==============

model SupportTicket {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String
  status      String   @default("open") // open, in_progress, resolved, closed
  priority    String   @default("normal") // low, normal, high, urgent
  response    String?
  respondedAt DateTime?
  respondedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("support_tickets")
}

// ============== SAAS CONFIG (SuperAdmin) ==============

model SaasConfig {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  description     String?
  updatedAt       DateTime @updatedAt

  @@map("saas_config")
}

// ============== MEDICATIONS ==============

model Category {
  id          String       @id @default(cuid())
  name        String
  description String?
  pharmacyId  String
  pharmacy    Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medications Medication[]
  createdAt   DateTime     @default(now())

  @@unique([name, pharmacyId])
  @@map("categories")
}

model Medication {
  id           String          @id @default(cuid())
  name         String
  genericName  String?
  barcode      String?
  description  String?
  dosage       String?
  form         String?         // tablet, syrup, injection, etc.
  categoryId   String?
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  pharmacyId   String
  pharmacy     Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  purchasePrice Float          @default(0)
  sellingPrice Float           @default(0)
  quantity     Int             @default(0)  // total stock (warehouse + shelf)
  shelfQuantity Int            @default(0)  // portion on shelves, sellable
  minStock     Int             @default(10)
  expiryDate   DateTime?
  location     String?         // shelf location
  requiresPrescription Boolean @default(false)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  stockMovements StockMovement[]
  saleItems      SaleItem[]
  inventoryItems InventoryItem[]

  @@map("medications")
}

// ============== STOCK ==============

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
  EXPIRED
  TRANSFER
}

model StockMovement {
  id           String       @id @default(cuid())
  medicationId String
  medication   Medication   @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  pharmacyId   String
  pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  type         MovementType
  quantity     Int
  location     String?      // "warehouse" | "shelf" — where the movement applies (destination for TRANSFER)
  reason       String?
  reference    String?      // PO number, sale ID, etc.
  unitPrice    Float?
  createdAt    DateTime     @default(now())

  @@map("stock_movements")
}

model Inventory {
  id          String          @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name        String
  status      String          @default("draft") // draft, in_progress, completed
  startedAt   DateTime?
  completedAt DateTime?
  items       InventoryItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("inventories")
}

model InventoryItem {
  id            String    @id @default(cuid())
  inventoryId   String
  inventory     Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  expectedQty   Int
  actualQty     Int?
  difference    Int?
  createdAt     DateTime  @default(now())

  @@map("inventory_items")
}

// ============== SALES ==============

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  INSURANCE
  CREDIT
}

model Sale {
  id            String        @id @default(cuid())
  pharmacyId    String
  pharmacy      Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  subtotal      Float
  tax           Float         @default(0)
  discount      Float         @default(0)
  total         Float
  paymentMethod PaymentMethod @default(CASH)
  customerName  String?
  customerPhone String?
  amountPaid    Float?        // espèces reçues (CASH uniquement) — null si non renseigné
  change        Float?        // monnaie rendue = amountPaid - total (CASH uniquement)
  isPrescription Boolean      @default(false)
  status        String        @default("completed") // completed, refunded, cancelled

  // Tiers payant (assurance / mutuelle / CMU / IPM)
  insuranceId       String?
  insurance         Insurance?            @relation(fields: [insuranceId], references: [id], onDelete: SetNull)
  beneficiaryId     String?
  beneficiary       InsuranceBeneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  insuranceCoverage Float?                // % pris en charge (snapshot, peut être surchargé par vente)
  insuranceAmount   Float?                // montant pris en charge par l'institution
  patientAmount     Float?                // reste à charge du patient (co-pay)
  insuranceClaimRef String?               // n° de bon / référence ordonnance fourni par le patient
  insuranceClaimStatus String?            @default("pending") // pending, billed, paid, rejected — null pour ventes non-INSURANCE

  // Avoirs (credit notes) — appliqués sur cette vente comme moyen de paiement complémentaire
  creditNoteAmount  Float?                // montant total déduit via avoir(s) sur cette vente
  creditNoteUsages  CreditNoteUsage[]

  // Avoir(s) émis suite à cette vente (annulation totale, retour, ordonnance partielle)
  creditNotesIssued CreditNote[]          @relation("CreditNoteOrigin")

  createdAt     DateTime      @default(now())

  @@index([pharmacyId, customerId])
  @@index([pharmacyId, insuranceId])
  @@index([pharmacyId, insuranceClaimStatus])
  @@map("sales")
}

// ============== AVOIRS (CREDIT NOTES) ==============
// Un avoir représente une dette de la pharmacie envers un client (l'inverse
// du carnet). Émis après un retour produit, une erreur de facturation,
// l'annulation d'une vente, ou une ordonnance partiellement honorée.
// Réutilisable au POS comme moyen de paiement complémentaire (réduit le total
// à payer ; la vente garde sa méthode de paiement réelle pour la compta).

model CreditNote {
  id             String   @id @default(cuid())
  pharmacyId     String
  pharmacy       Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  // Lien client optionnel (un avoir peut être nominatif via Customer ou
  // anonyme via snapshot customerName/Phone — comme une vente CASH).
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String?
  customerPhone  String?

  // Vente d'origine (optionnelle — annulation/retour la référence ; ordonnance
  // partielle peut la référencer ; erreur de caisse n'est pas forcément liée).
  originSaleId   String?
  originSale     Sale?    @relation("CreditNoteOrigin", fields: [originSaleId], references: [id], onDelete: SetNull)

  reason         String   @default("OTHER") // RETURN, BILLING_ERROR, CANCELLATION, PARTIAL_PRESCRIPTION, OTHER
  amount         Float                       // montant initial de l'avoir
  usedAmount     Float    @default(0)        // montant déjà consommé via une ou plusieurs ventes
  status         String   @default("active") // active, partially_used, used, expired, cancelled
  expiresAt      DateTime?                   // null = pas d'expiration
  notes          String?
  createdBy      String?                     // userId de l'émetteur

  usages         CreditNoteUsage[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([pharmacyId, status])
  @@index([pharmacyId, customerId])
  @@map("credit_notes")
}

model CreditNoteUsage {
  id            String     @id @default(cuid())
  pharmacyId    String
  pharmacy      Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  creditNoteId  String
  creditNote    CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  saleId        String
  sale          Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount        Float                       // montant déduit sur cette vente
  createdAt     DateTime   @default(now())

  @@index([pharmacyId, creditNoteId])
  @@index([pharmacyId, saleId])
  @@map("credit_note_usages")
}

// ============== CARNET (CRÉDIT CLIENT) ==============

model Customer {
  id          String          @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String?
  address     String?
  notes       String?
  creditLimit Float           @default(0) // 0 = pas de limite
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  sales       Sale[]
  payments    CreditPayment[]
  creditNotes CreditNote[]

  @@unique([pharmacyId, phone])
  @@index([pharmacyId, isActive])
  @@map("customers")
}

model CreditPayment {
  id          String   @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Float
  method      String   @default("CASH") // CASH, MOBILE_MONEY, CARD
  receivedBy  String?  // userId du vendeur qui a encaissé
  notes       String?
  createdAt   DateTime @default(now())

  @@index([pharmacyId, customerId])
  @@map("credit_payments")
}

// ============== ASSURANCES / TIERS PAYANT ==============
// Modélise les complémentaires santé : assurances privées, mutuelles, CMU,
// institutions de prévoyance maladie (IPM), etc. Le pharmacien peut les
// enregistrer, leur rattacher des bénéficiaires (titulaires + ayants droits)
// et déclarer une vente comme prise en charge partielle ou totale.

model Insurance {
  id           String   @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name         String
  type         String   @default("ASSURANCE") // ASSURANCE, MUTUELLE, CMU, IPM, AUTRE
  code         String?  // n° contrat / convention chez la pharmacie
  contactName  String?
  phone        String?
  email        String?
  address      String?
  coverageRate Float    @default(80) // % par défaut pris en charge sur les ventes
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  beneficiaries InsuranceBeneficiary[]
  sales         Sale[]

  @@unique([pharmacyId, name])
  @@index([pharmacyId, isActive])
  @@map("insurances")
}

model InsuranceBeneficiary {
  id              String    @id @default(cuid())
  pharmacyId      String
  pharmacy        Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  insuranceId     String
  insurance       Insurance @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  fullName        String
  membershipNumber String?  // matricule / n° d'affilié
  phone           String?
  birthDate       DateTime?
  relationship    String   @default("HOLDER") // HOLDER, SPOUSE, CHILD, PARENT, OTHER
  // Pour les ayants droits : pointer vers le titulaire (HOLDER) du même contrat.
  // Null pour le titulaire lui-même.
  holderId        String?
  holder          InsuranceBeneficiary?  @relation("BeneficiaryDependents", fields: [holderId], references: [id], onDelete: SetNull)
  dependents      InsuranceBeneficiary[] @relation("BeneficiaryDependents")
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sales           Sale[]

  @@unique([insuranceId, membershipNumber])
  @@index([pharmacyId, insuranceId])
  @@index([insuranceId, isActive])
  @@map("insurance_beneficiaries")
}

model SaleItem {
  id           String     @id @default(cuid())
  saleId       String
  sale         Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id])
  quantity     Int
  unitPrice    Float
  total        Float
  createdAt    DateTime   @default(now())

  @@map("sale_items")
}

// ============== PRO FORMA (DEVIS — SANS VALEUR COMPTABLE) ==============
// Un Proforma est un devis estimatif remis au client. Il ne décrémente pas
// le stock, n'entre pas dans le chiffre d'affaires et n'est pas lié à une
// méthode de paiement. Il peut être converti en vente ultérieurement : la
// conversion passe par le POS classique qui, lui, applique toutes les règles
// métier (stock, audit, événement temps réel). Ce modèle sert uniquement de
// snapshot pour réimpression et conversion.

model Proforma {
  id             String         @id @default(cuid())
  pharmacyId     String
  pharmacy       Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  userId         String         // auteur du devis
  items          ProformaItem[]

  // Snapshot montants (calculés côté serveur à la création/édition)
  subtotal       Float
  discount       Float          @default(0) // montant de la remise
  discountRate   Float          @default(0) // % de remise appliqué
  total          Float

  // Client (optionnel — pas de relation vers Customer, juste un snapshot)
  customerName   String?
  customerPhone  String?

  // Durée de validité en jours (0 = illimitée) — info imprimée sur le devis
  validityDays   Int            @default(15)

  notes          String?
  status         String         @default("active") // active, converted, cancelled
  convertedSaleId String?       // si converti en vente, id de la Sale résultante
  convertedAt    DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([pharmacyId, status])
  @@index([pharmacyId, createdAt])
  @@map("proformas")
}

model ProformaItem {
  id            String     @id @default(cuid())
  proformaId    String
  proforma      Proforma   @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  medicationId  String?    // nullable si le médicament a été supprimé plus tard
  medicationName String    // snapshot du nom
  medicationRef  String?   // snapshot du code-barres / ref
  quantity      Int
  unitPrice     Float
  total         Float
  createdAt     DateTime   @default(now())

  @@index([proformaId])
  @@map("proforma_items")
}

// ============== PENDING SALES (ventes en attente) ==============

model PendingSale {
  id             String            @id @default(cuid())
  pharmacyId     String
  pharmacy       Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  userId         String            // auteur (pharmacien / caissier qui a mis la vente en attente)
  items          PendingSaleItem[]

  // Snapshot panier
  subtotal       Float
  discount       Float             @default(0)
  discountRate   Float             @default(0)
  tax            Float             @default(0)
  total          Float

  // Client (snapshot — pas de FK Customer pour rester aligné sur Proforma)
  customerName   String?
  customerPhone  String?
  customerId     String?           // optionnel : si vente CRÉDIT prévue, on garde l'id pour repérer le client carnet

  // Mode paiement prévu (optionnel, peut changer à la reprise)
  paymentMethod  String?           // CASH | MOBILE_MONEY | CARD | INSURANCE | CREDIT

  // Contexte assurance / ordonnance
  insuranceId       String?
  beneficiaryId     String?
  insuranceCoverage Float?
  isPrescription    Boolean        @default(false)

  // Avoir éventuellement appliqué (sera revalidé à la reprise)
  creditNoteId      String?
  creditNoteAmount  Float?

  // Raison + note
  reason         String            // NO_PAYMENT | MISSING_PRESCRIPTION | AWAITING_INSURANCE | OUT_OF_STOCK | OTHER
  note           String?

  // Cycle de vie
  status         String            @default("active") // active | converted | cancelled
  convertedSaleId String?
  convertedAt    DateTime?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([pharmacyId, status])
  @@index([pharmacyId, createdAt])
  @@map("pending_sales")
}

model PendingSaleItem {
  id             String      @id @default(cuid())
  pendingSaleId  String
  pendingSale    PendingSale @relation(fields: [pendingSaleId], references: [id], onDelete: Cascade)
  medicationId   String?     // nullable si le médicament a été supprimé entre temps
  medicationName String      // snapshot
  medicationRef  String?
  quantity       Int
  unitPrice      Float
  total          Float
  createdAt      DateTime    @default(now())

  @@index([pendingSaleId])
  @@map("pending_sale_items")
}

// ============== SUPPLIERS ==============

model Supplier {
  id          String          @id @default(cuid())
  name        String
  contact     String?
  phone       String?
  email       String?
  address     String?
  pharmacyId  String
  pharmacy    Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  orders      PurchaseOrder[]
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
  total       Float               @default(0)
  status      String              @default("pending") // pending, ordered, received, cancelled
  orderedAt   DateTime?
  receivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicationName  String
  quantity        Int
  unitPrice       Float
  total           Float
  receivedQty     Int?
  createdAt       DateTime      @default(now())

  @@map("purchase_order_items")
}

// ============== EXPENSES & ACCOUNTING ==============

model Expense {
  id          String   @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  category    String   // rent, utilities, salaries, supplies, etc.
  description String?
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("expenses")
}

model Payroll {
  id               String   @id @default(cuid())
  pharmacyId       String
  pharmacy         Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  employeeName     String
  employeeRole     String?     // poste occupé
  month            Int
  year             Int

  // Gains
  baseSalary       Float       // Salaire de base
  seniority        Float    @default(0) // Prime d'ancienneté
  transportAllowance Float  @default(0) // Indemnité de transport
  housingAllowance Float    @default(0) // Indemnité de logement
  bonuses          Float    @default(0) // Primes diverses
  overtime         Float    @default(0) // Heures supplémentaires
  grossSalary      Float       // Salaire brut (calculé)

  // Retenues salariales (part employé)
  ipresGeneral     Float    @default(0) // IPRES régime général 5.6%
  ipresCadre       Float    @default(0) // IPRES régime cadre 2.4% (si cadre)
  cssAccident      Float    @default(0) // CSS cotisation AT (pas d'employé, mais réservé)
  cssMaladie       Float    @default(0) // CSS maladie
  incomeTax        Float    @default(0) // IR (Impôt sur le Revenu) - barème progressif
  trimf            Float    @default(0) // TRIMF (Taxe Représentative de l'Impôt du Minimum Fiscal)
  cfce             Float    @default(0) // CFCE (Contribution Forfaitaire à la Charge de l'Employeur)
  otherDeductions  Float    @default(0) // Autres retenues

  // Charges patronales (pour info bulletin)
  employerIpres    Float    @default(0) // IPRES patronal 8.4%
  employerCss      Float    @default(0) // CSS patronal (AT, PF, maladie)
  employerCfce     Float    @default(0) // CFCE patronale

  // Totaux
  totalGross       Float       // Total brut
  totalDeductions  Float       // Total retenues salariales
  netSalary        Float       // Net à payer

  // Workflow
  status           String   @default("draft")   // draft, validated, paid
  validatedBy      String?  // ID du responsable qui a validé
  validatedAt      DateTime?
  paidAt           DateTime?
  notes            String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([pharmacyId, employeeName, month, year])
  @@map("payrolls")
}

// ============== PERSONNEL ==============

model Attendance {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyId  String
  pharmacy    Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  date        DateTime  @default(now())
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("present") // present, absent, late, leave
  notes       String?
  createdAt   DateTime  @default(now())

  @@map("attendances")
}

// ============== AUDIT & ANOMALIES ==============

model AuditLog {
  id          String   @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // CREATE, UPDATE, DELETE, LOGIN, SALE, etc.
  entity      String   // medication, sale, user, etc.
  entityId    String?
  details     String?  // JSON string with change details
  isSuspicious Boolean @default(false)
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([pharmacyId, createdAt])
  @@index([isSuspicious])
  @@map("audit_logs")
}

// ============== NOTIFICATIONS ==============

model Notification {
  id          String   @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   // stock_low, expiry, fraud, payment, system
  severity    String   @default("info") // info, warning, critical
  isRead      Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())

  @@index([pharmacyId, isRead])
  @@map("notifications")
}
